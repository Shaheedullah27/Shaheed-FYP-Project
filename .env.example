# --- AI ResumeMatch environment template ---
# Copy this file to backend/.env (local) and fill in real values.
# NEVER commit backend/.env — it is already covered by .gitignore (.env*).

# GEMINI_API_KEY: Optional. Enables the AI contextual insights feature on the
# results page. Get a key from https://aistudio.google.com/apikey and set it
# here. Without it, the app still runs the full local analysis; the frontend
# simply shows "AI insights unavailable".
GEMINI_API_KEY=

# GEMINI_MODEL: Optional. Override the Gemini model used for AI insights.
# Defaults to gemini-3.5-flash-lite (fast, cost-efficient, stable).
GEMINI_MODEL=gemini-3.5-flash-lite
